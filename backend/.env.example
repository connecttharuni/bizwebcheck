# BizWebCheck Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bizwebcheck?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bizwebcheck

# JWT Secret for Session Authentication
JWT_SECRET=bizwebcheck_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Google Places API (New) Key
# Leave as placeholder to use realistic mock data provider during testing
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Razorpay Payment Integration (Test Mode credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Website Verification Timeout
VERIFIER_TIMEOUT_MS=6000
